# ---------------------------------------------------------------------------
# LabLoop environment configuration
# Copy to `.env.local` for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Local persistent SQLite database used by the runnable demo build.
# This file is gitignored. The folder is created automatically.
LABLOOP_DB_PATH=data/labloop.db

# Required when NODE_ENV=production. 32+ random bytes, base64url encoded.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LABLOOP_SESSION_SECRET=

# Set to 1 only when running `next start` locally over plain HTTP.
LABLOOP_INSECURE_COOKIES=0

# Seed the fictional demo institution when the database is empty (default 1).
LABLOOP_SEED_DEMO=1

# Public base URL used in documentation and metadata (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase deployment path (schema + RLS prepared, not wired in this build)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix this variable with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
